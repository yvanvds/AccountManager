{
  "//": "Azure AD app-registration values, for running from a checkout.",
  "//1": "Copy this file to aad.local.json (gitignored) and fill in the real",
  "//2": "values, then run:",
  "//3": "  flutter run -d windows --dart-define-from-file=aad.local.json",
  "//4": "This is the middle of three resolution layers (#384). An *installed*",
  "//5": "copy has no command line, so it reads the same four values from",
  "//6": "%APPDATA%\\AccountManager\\connection.json instead, written from",
  "//7": "Instellingen -> Verbinding -> Azure AD. The compiled defaults are the",
  "//8": "empty string: these identifiers are not in this public repository.",
  "//9": "Without any of the three, AadAppConfig.isConfigured is false and every",
  "//10": "screen that needs a token stands down -- except Instellingen, which is",
  "//11": "where the values are supplied.",
  "//12": "AAD_CLIENT_ID must be a public-client app registration with",
  "//13": "http://localhost:8765/auth-redirect registered under Authentication ->",
  "//14": "Mobile and desktop applications (see windows/runner/README-aad-broker.md).",
  "//15": "SCHOOL_PREFIX is only a fallback: the persisted settings win when set.",

  "AAD_CLIENT_ID": "",
  "AAD_TENANT_ID": "",
  "AAD_DOMAIN": "",
  "SCHOOL_PREFIX": ""
}
