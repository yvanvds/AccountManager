# Live Smartschool credentials for the capture script and integration test.
#
# Copy this file to `.smartschool.env` (gitignored) and fill in the real
# values, then source it before running:
#
#     # PowerShell
#     Get-Content .smartschool.env | ForEach-Object {
#       if ($_ -match '^([^#=]+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] }
#     }
#
#     # bash
#     set -a; source .smartschool.env; set +a
#
# Never commit a populated copy. Real values stay local; CI reads them
# from `secrets.SMARTSCHOOL_*` (see .github/workflows/dart.yml).
#
# SMARTSCHOOL_SITE is the tenant subdomain — the part before
# `.smartschool.be` (e.g. `sanctamaria-aarschot`).
# SMARTSCHOOL_ACCESSCODE is the web-services passphrase configured in the
# tenant's Smartschool settings.

SMARTSCHOOL_SITE=
SMARTSCHOOL_ACCESSCODE=
