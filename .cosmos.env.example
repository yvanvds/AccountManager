# Live Cosmos DB config for the opt-in Cosmos adapter round-trip
# (packages/account_state/test/integration/cosmos_live_test.dart, issue #114).
#
# Copy this file to `.cosmos.env` (gitignored) and fill in the endpoint and
# database. Leave COSMOS_ACCESS_TOKEN blank: it is a bearer token for the
# Cosmos resource and expires in ~1 hour, so mint a fresh one per run rather
# than storing it, e.g.:
#
#     $env:COSMOS_ACCESS_TOKEN = az account get-access-token `
#       --resource https://cosmos.azure.com --query accessToken -o tsv
#
# The check is WRITE-CAPABLE — it round-trips the settings/queue documents and
# mints a disposable identity key — so it is manual/opt-in only (not CI) per
# the live-testing policy, and each test restores or deletes what it wrote.
# `./tool/live-tests.ps1 -Only cosmos` mints the token and runs it.
#
# COSMOS_ENDPOINT      the account data-plane endpoint.
# COSMOS_DATABASE      the SQL-API database name.
# COSMOS_ACCESS_TOKEN  a bearer token for https://cosmos.azure.com.

COSMOS_ENDPOINT=https://accountmanager-cosmos-arcadia.documents.azure.com:443/
COSMOS_DATABASE=accountmanager
COSMOS_ACCESS_TOKEN=
