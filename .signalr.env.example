# Live Azure SignalR config for the opt-in realtime round-trip
# (packages/account_state/test/integration/signalr_live_test.dart, issue #124).
#
# Copy this file to `.signalr.env` (gitignored) and fill in the endpoint (and
# hub, if not the default `reconcile`). Leave SIGNALR_ACCESS_TOKEN blank: it is
# a bearer token for the SignalR resource and expires in ~1 hour, so mint a
# fresh one per run rather than storing it, e.g.:
#
#     $env:SIGNALR_ACCESS_TOKEN = az account get-access-token `
#       --resource https://signalr.azure.com --query accessToken -o tsv
#
# The check is WRITE-CAPABLE — it broadcasts a probe signal to every connected
# operator — so it is manual/opt-in only (not CI) per the live-testing policy.
# The probe carries a sentinel generation and no data, and writes nothing to any
# store. `./tool/live-tests.ps1 -Only signalr` mints the token and runs it.
#
# SIGNALR_ENDPOINT      the service data-plane endpoint.
# SIGNALR_HUB           the hub name (optional; defaults to `reconcile`).
# SIGNALR_ACCESS_TOKEN  a bearer token for https://signalr.azure.com.

SIGNALR_ENDPOINT=https://accountmanager-signalr.service.signalr.net
SIGNALR_HUB=reconcile
SIGNALR_ACCESS_TOKEN=
